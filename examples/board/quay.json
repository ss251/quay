{
  "account": "harbour-board.testnet",
  "network": "testnet",
  "site": {
    "dir": "site",
    "spa": false
  },
  "files": {
    "external_over": 32768,
    "store": "fastfs"
  },
  "collections": {
    "posts": {
      "write": "anyone",
      "payer": "site",
      "max_doc_bytes": 2000,
      "moderated": true,
      "max_docs_per_account": 50,
      "on_add": "moderate"
    }
  },
  "routes": [
    {
      "pattern": "/",
      "kind": "list",
      "collection": "posts",
      "template": "templates/home.html",
      "limit": 10,
      "order": "desc",
      "pinned_first": true,
      "also": [
        {
          "name": "digest",
          "collection": "_fn",
          "prefix": "digest-",
          "limit": 1,
          "order": "desc"
        }
      ]
    },
    {
      "pattern": "/posts/:id",
      "kind": "doc",
      "collection": "posts",
      "template": "templates/post.html"
    },
    {
      "pattern": "/api/posts",
      "kind": "json",
      "collection": "posts",
      "limit": 20,
      "order": "desc"
    },
    {
      "pattern": "/api/posts/:id",
      "kind": "json",
      "collection": "posts"
    }
  ],
  "members": {
    "open": true
  },
  "functions": {
    "moderate": {
      "dir": "../../functions/moderate",
      "call": "owner",
      "payer": "site",
      "secrets": [
        "MOD_API_KEY"
      ]
    },
    "digest": {
      "dir": "../../functions/digest",
      "call": "owner",
      "payer": "site"
    }
  },
  "cron": [
    {
      "name": "digest",
      "every_minutes": 60,
      "fn": "digest",
      "input": {}
    }
  ],
  "payments": {
    "token": "usdc.fakes.testnet",
    "products": {
      "pin": {
        "name": "Pin a post for 24 hours",
        "price_yocto": "100000000000000000000000",
        "price_token": "100000",
        "grant": "pin",
        "pin_seconds": 86400
      }
    }
  },
  "rpc": "https://test.rpc.fastnear.com",
  "gateway": "https://harbour-board.testnet.page"
}
